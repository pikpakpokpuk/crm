DATABASE_URL="postgresql://user:password@localhost:5432/crm_db"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=5000
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# Production requires these (server refuses to start otherwise):
# JWT_SECRET must be 32+ random chars (e.g. `openssl rand -hex 32`)
# ENCRYPTION_KEY encrypts stored integration credentials; 32+ random chars, keep it backed up separately
# ENCRYPTION_KEY="..."
# TRUST_PROXY=1   # when behind one reverse proxy, so login rate limiting sees real IPs

# Automated backups (see docs/BACKUPS.md) — all optional, sane defaults apply
# BACKUP_DIR="../backups"
# BACKUP_RETENTION_COUNT=14
# BACKUP_CRON="0 3 * * *"
# DISABLE_AUTO_BACKUP="true"
